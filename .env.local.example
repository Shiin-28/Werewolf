# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... on older projects

# Dev only: each browser tab gets its own anonymous identity (so tabs = different players).
# Set to "false" to share one identity across tabs like production does.
# NEXT_PUBLIC_PER_TAB_IDENTITY=true
